{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Bauzeit je Gebäude, je Stadtteil",
 "x-datei": "jahre/*.js",
 "x-global": "^KIEZ_JAHR_\\d{2}$",
 "x-odbl": false,
 "x-eigentuemer": "B4 (skripte/24_jahre_kaskade.py)",
 "description": "Gebäude des Snapshots auswertung.gebaeude_stand_20261105, EPSG:4326. j = Jahr nur bei belegten Jahren von Gebäuden ohne Wohnraum; Gebäude mit Wohnraum tragen nur die Klasse k, auch Denkmale, weil ALKIS keine Zahl der Wohneinheiten führt (Korrektur 6, Nachlauf N3). Keine Adresse, keine Gebäudekennung (oid, gml_id). Kein OSM- oder Wikipedia-Wert.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "type",
  "stand",
  "klassen",
  "quellen",
  "hinweis",
  "features"
 ],
 "properties": {
  "fixture": {
   "const": true,
   "description": "nur in daten/fixtures/: klar unechte Beispielwerte"
  },
  "stand": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
   "description": "Tag der Auswertung"
  },
  "hinweis": {
   "type": "string"
  },
  "type": {
   "const": "FeatureCollection"
  },
  "klassen": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "string"
   }
  },
  "quellen": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "$ref": "#/$defs/quelle"
   }
  },
  "features": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "type",
     "geometry",
     "properties"
    ],
    "properties": {
     "type": {
      "const": "Feature"
     },
     "geometry": {
      "type": "object"
     },
     "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "j",
       "k",
       "g",
       "q",
       "s"
      ],
      "properties": {
       "j": {
        "type": [
         "integer",
         "null"
        ]
       },
       "k": {
        "type": [
         "integer",
         "null"
        ],
        "description": "Index in klassen"
       },
       "g": {
        "enum": [
         "belegt",
         "geschaetzt",
         "nicht_datiert"
        ]
       },
       "d": {
        "type": "boolean",
        "description": "Denkmal"
       },
       "q": {
        "type": [
         "string",
         "null"
        ]
       },
       "s": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
       },
       "h": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Höhe für die 3D-Ansicht in ganzen Metern: ALKIS-Objekthöhe über Gelände, sonst Geschosse × 3 m, sonst 3 m"
       },
       "hq": {
        "enum": ["kataster", "geschosse", "ersatz"],
        "description": "Herkunft der Höhe h"
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "quelle": {
   "type": "object",
   "required": [
    "quelle",
    "lizenz",
    "vermerk"
   ],
   "properties": {
    "quelle": {
     "type": "string",
     "minLength": 3
    },
    "lizenz": {
     "type": "string",
     "minLength": 3
    },
    "vermerk": {
     "type": "string",
     "minLength": 10,
     "description": "Namensnennung wie gefordert. Bei dl-de/by-2-0 mit Link zum Lizenztext und, wenn verändert, 'Daten verändert (eigene Berechnung)'."
    },
    "url": {
     "type": "string"
    },
    "stand": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}
