{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Versorgung je Raumeinheit, luftlinie",
 "x-datei": "planer.js",
 "x-global": "^KIEZ_PLANER$",
 "x-odbl": false,
 "x-eigentuemer": "A6 (skripte/15_planer.py)",
 "description": "Aussagen je Raumeinheit (Planungsraum, solange H1 fehlt Stadtteil). Feine Zensusklassen nur je Raumeinheit mit mindestens 100 EW (config/richtwerte.yaml, geheimhaltung). Einwohnerzahlen gerundet (rundung).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "stand",
  "raumebene",
  "rundung",
  "hinweis",
  "quellen",
  "raeume"
 ],
 "properties": {
  "fixture": {
   "const": true,
   "description": "nur in daten/fixtures/: klar unechte Beispielwerte"
  },
  "stand": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
   "description": "Tag der Auswertung"
  },
  "hinweis": {
   "type": "string"
  },
  "raumebene": {
   "enum": [
    "planungsraum",
    "stadtteil"
   ]
  },
  "rundung": {
   "type": "object",
   "required": [
    "ew"
   ],
   "properties": {
    "ew": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "quellen": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "$ref": "#/$defs/quelle"
   }
  },
  "raeume": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "name",
     "ew",
     "werte"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "ew": {
      "type": [
       "integer",
       "null"
      ]
     },
     "werte": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "kennzahl",
        "art",
        "wert",
        "einheit",
        "methode",
        "status",
        "q",
        "stand",
        "unsicherheit"
       ],
       "properties": {
        "kennzahl": {
         "type": "string",
         "description": "z. B. anteil_in_radius, ew_je_einrichtung, plaetze_je_kind, oepnv_erschliessung, gruen_m2_je_ew"
        },
        "art": {
         "type": "string"
        },
        "wert": {
         "type": [
          "number",
          "null"
         ]
        },
        "einheit": {
         "type": "string"
        },
        "methode": {
         "const": "luftlinie"
        },
        "status": {
         "enum": [
          "amtlich",
          "orientierung"
         ]
        },
        "vorlaeufig": {
         "type": "boolean",
         "description": "true bei Grundschulwerten ohne Schulbezirk (H2)"
        },
        "richtwert": {
         "type": "object",
         "required": [
          "wert",
          "einheit",
          "q"
         ],
         "properties": {
          "wert": {
           "type": "number"
          },
          "einheit": {
           "type": "string"
          },
          "q": {
           "type": "string"
          },
          "seite": {
           "type": "string"
          }
         }
        },
        "zielgruppe": {
         "type": "string"
        },
        "q": {
         "type": "string",
         "description": "Schlüssel in quellen"
        },
        "stand": {
         "type": "string",
         "description": "Stichtag der Daten, z. B. 'Zensus 15.05.2022, Plätze 05.11.2026'"
        },
        "unsicherheit": {
         "type": "string",
         "description": "Hinweis zu Cell-Key-Rauschen, Rundung, Stichtag"
        },
        "prognose": {
         "type": "object",
         "description": "Prognose 2030/2035 je Raumeinheit, sobald H11 vorliegt"
        }
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "quelle": {
   "type": "object",
   "required": [
    "quelle",
    "lizenz",
    "vermerk"
   ],
   "properties": {
    "quelle": {
     "type": "string",
     "minLength": 3
    },
    "lizenz": {
     "type": "string",
     "minLength": 3
    },
    "vermerk": {
     "type": "string",
     "minLength": 10,
     "description": "Namensnennung wie gefordert. Bei dl-de/by-2-0 mit Link zum Lizenztext und, wenn verändert, 'Daten verändert (eigene Berechnung)'."
    },
    "url": {
     "type": "string"
    },
    "stand": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}
