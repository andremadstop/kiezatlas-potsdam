{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Planungsräume der Landeshauptstadt Potsdam (Grenzen)",
 "description": "Grenzen der 19 Planungsräume aus dem Handdownload H1 (Open-Data-Portal der LHP, dl-de/by-2-0), Koordinaten EPSG:4326 auf 5 Stellen gerundet. Schlüssel nr = Schlüssel von raeume in planer.js. Lädt nur die Planer-Seite, nie die Startseite.",
 "x-datei": "planungsraeume.js",
 "x-global": "^KIEZ_PLANUNGSRAEUME$",
 "x-odbl": false,
 "x-eigentuemer": "I1 (skripte/17_planungsraeume_js.py), bis Tabelle 0.4 einen Eigentümer nennt",
 "type": "object",
 "required": ["type", "stand", "lizenz", "vermerk", "features"],
 "properties": {
  "type": {"const": "FeatureCollection"},
  "stand": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "lizenz": {"const": "dl-de/by-2-0"},
  "vermerk": {"type": "string", "pattern": "Daten verändert"},
  "quelle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "features": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["type", "geometry", "properties"],
    "properties": {
     "type": {"const": "Feature"},
     "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {"type": {"enum": ["Polygon", "MultiPolygon"]}}
     },
     "properties": {
      "type": "object",
      "required": ["nr", "name", "flaeche_km2"],
      "additionalProperties": false,
      "properties": {
       "nr": {"type": "string", "pattern": "^[1-6]0[1-9]$"},
       "name": {"type": "string", "minLength": 1},
       "flaeche_km2": {"type": "number", "minimum": 0}
      }
     }
    }
   }
  }
 }
}
